{
  "name": "attache-bridge",
  "version": "0.1.0",
  "description": "Bridge daemon that exposes omp (omp.sh) coding-agent sessions to the Attaché iOS app over WebSocket",
  "license": "MIT",
  "type": "module",
  "bin": {
    "attache-bridge": "./src/main.ts"
  },
  "scripts": {
    "start": "bun run src/main.ts serve",
    "dev": "bun --watch run src/main.ts serve",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
